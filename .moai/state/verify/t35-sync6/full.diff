+  elif [ "$DEN" -eq "$NUM" ] && [ "$OUTSIDE" -eq 0 ] && [ "$CWD_BEFORE" = "$CWD_AFTER" ]; then
+    echo "VERDICT=PASS (분모=$DEN 분자=$NUM 바깥=0 cwd 불변)"
+  else
+    echo "VERDICT=FAIL (분모=$DEN 분자=$NUM 바깥=$OUTSIDE)"
+  fi
