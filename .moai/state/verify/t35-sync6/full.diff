++// ── ㉠ 표면: 대화 기록 파서 ──────────────────────────────────────────
++export interface ToolUse { name: string; input: unknown }
++
++export interface Transcript {
++  sessionIds: string[]
++  cwds: string[]
++  toolUses: ToolUse[]
++  /** 채널 도구 호출에 결과가 돌아온 짝의 수 */
