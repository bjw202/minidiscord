+#!/usr/bin/env bash
+# AC-LIVEENV-010 · AC-LIVEENV-011 · AC-LIVEENV-012 의 증거를 만든다.
+set -u
+set -o pipefail
+WT=$(git -C "$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)" rev-parse --show-toplevel)
+EV="$WT/.moai/specs/SPEC-LIVEENV-001/evidence"
+BASE=5edd97f     # progress.md §E.2 가 귀속시킨 리터럴
+SC="$WT/data/live-env/e11"
+rm -rf "$SC"; mkdir -p "$SC" "$EV"
+cd "$WT" || exit 1
+
+# ── AC-LIVEENV-010 ───────────────────────────────────────────────────
+E10="$EV/E10-extract-run.txt"
+
+# [HARD] 실 세션 절반(「## 절반 3」)은 M8 에서만 얻을 수 있고 다시 만들 수 없다 —
+# 그 관측 뒤 대화 기록 후보가 둘로 늘어(변이 ⑤ 의 부작용) 같은 측정이 E-3 로 끝나기 때문이다.
+# 이 드라이버가 E10 을 처음부터 다시 쓰면 그 절반이 지워지므로, 있으면 떼어 두었다가 다시 붙인다.
+# 보존 대상은 «관측됨» 절 하나뿐이다. 「미관측」 절까지 함께 떠 오면 두 절이 나란히 남아
+# 같은 자리가 두 번 나온다(실측으로 겪었다) — 앵커를 관측된 절로 좁힌다.
+KEEP3="$SC/e10-half3.txt"
+if [ -f "$E10" ] && grep -q '^## 절반 3 — 실 세션 (대화 기록 표면) : 관측됨' "$E10"; then
